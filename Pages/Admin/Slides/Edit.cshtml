@page "{id:int?}"
@model CarsiDekor.Web.Pages.Admin.Slides.EditModel
@{
    var isNew = ViewContext.RouteData.Values["id"] is null;
    ViewData["Title"] = isNew ? "Yeni slayt" : "Slaydı düzenle";
}

<div class="page-bar">
    <h1>@ViewData["Title"]</h1>
    <a class="btn btn-outline-dark" asp-page="/Admin/Slides/Index">Listeye dön</a>
</div>

<div class="panel" style="max-width:640px">
    <form method="post" enctype="multipart/form-data" novalidate>
        <div class="mb-4">
            <label class="form-label">Fotoğraf</label>
            <div class="hint mb-2">Geniş (yatay) fotoğraf kullanın; ideal boyut 1920×900 piksel. JPG, PNG veya WEBP, en fazla 8 MB.</div>

            @if (!string.IsNullOrEmpty(Model.CurrentImage))
            {
                <img src="@Model.CurrentImage" alt="Mevcut fotoğraf" class="mb-2 d-block" style="width:100%;max-width:420px;aspect-ratio:1920/900;object-fit:cover;border-radius:6px" />
                <div class="hint mb-2">Değiştirmek için yeni bir dosya seçin, boş bırakırsanız mevcut fotoğraf kalır.</div>
            }

            <input asp-for="ImageFile" type="file" accept="image/*" class="form-control" />
            <span asp-validation-for="ImageFile" class="field-error"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Title" class="form-label">Başlık</label>
            <input asp-for="Input.Title" class="form-control" placeholder="örn: Ürününüz vitrinde parlasın" />
            <span asp-validation-for="Input.Title" class="field-error"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.Subtitle" class="form-label">Alt yazı</label>
            <input asp-for="Input.Subtitle" class="form-control" />
            <span asp-validation-for="Input.Subtitle" class="field-error"></span>
            <div class="hint mt-1">Başlık ve alt yazıyı boş bırakırsanız fotoğraf yazısız gösterilir.</div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="Input.LinkText" class="form-label">Buton yazısı</label>
                <input asp-for="Input.LinkText" class="form-control" placeholder="örn: İşlerimize göz atın" />
                <span asp-validation-for="Input.LinkText" class="field-error"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.LinkUrl" class="form-label">Buton adresi</label>
                <input asp-for="Input.LinkUrl" class="form-control" placeholder="/Projects" />
                <span asp-validation-for="Input.LinkUrl" class="field-error"></span>
            </div>
            <div class="col-12 hint">Site içi için <code>/Projects</code> veya <code>/Contact</code> yazın. Buton yazısı ya da adresi boşsa buton görünmez.</div>
        </div>

        <div class="mb-4 d-flex align-items-end gap-4">
            <div>
                <label asp-for="Input.DisplayOrder" class="form-label">Sıra</label>
                <input asp-for="Input.DisplayOrder" class="form-control" style="max-width:120px" />
            </div>
            <label class="form-check-label pb-2">
                <input type="checkbox" asp-for="Input.IsActive" class="form-check-input" />
                Sitede göster
            </label>
        </div>

        <button type="submit" class="btn btn-ruby">Kaydet</button>
        <a class="btn btn-outline-dark" asp-page="/Admin/Slides/Index">Vazgeç</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
