@page
@model CarsiDekor.Web.Pages.Admin.Slides.IndexModel
@{
    ViewData["Title"] = "Slider";
}

<div class="page-bar">
    <h1>Ana sayfa slider'ı</h1>
    <a class="btn btn-ruby" asp-page="/Admin/Slides/Edit">Yeni slayt ekle</a>
</div>

<p class="hint mb-3">
    Ana sayfanın en üstündeki büyük fotoğraf alanı. Sıra numarası küçük olan önce gösterilir.
    Hiç aktif slayt yoksa sitede geçici örnek görsel görünür.
</p>

@if (Model.Rows.Any())
{
    <div class="table-wrap">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th></th>
                    <th>Başlık</th>
                    <th>Sıra</th>
                    <th>Durum</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var s in Model.Rows)
            {
                <tr>
                    <td style="width:130px">
                        <img src="@s.ImagePath" alt="" style="width:110px;height:52px;object-fit:cover;border-radius:4px" />
                    </td>
                    <td>@(string.IsNullOrWhiteSpace(s.Title) ? "(başlıksız)" : s.Title)</td>
                    <td>@s.DisplayOrder</td>
                    <td>@(s.IsActive ? "Yayında" : "Gizli")</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-dark" asp-page="/Admin/Slides/Edit" asp-route-id="@s.Id">Düzenle</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@s.Id" class="d-inline"
                              onsubmit="return confirm('Bu slayt silinsin mi?')">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="panel">
        <p class="mb-3">Henüz slayt eklenmedi.</p>
        <a class="btn btn-ruby" asp-page="/Admin/Slides/Edit">İlk slaydı ekle</a>
    </div>
}
