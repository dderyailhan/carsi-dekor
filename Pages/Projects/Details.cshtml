@page "{id:int}"
@model CarsiDekor.Web.Pages.Projects.DetailsModel
@{
    var p = Model.Item;
    ViewData["Title"] = $"{p.Title} - {p.Category.Name}";
    ViewData["Crumbs"] = new List<Crumb>
    {
        new("Ana sayfa", "/"),
        new("Kategoriler", "/Projects"),
        new(p.Category.Name, "/Projects?kategori=" + p.Category.Slug),
        new(p.Title, $"/Projects/Details/{p.Id}")
    };
    ViewData["OgType"] = "article";
    if (!string.IsNullOrEmpty(p.CoverImagePath)) ViewData["OgImage"] = p.CoverImagePath;
    ViewData["Description"] = string.IsNullOrWhiteSpace(p.Description)
        ? $"{p.Title}: kuyumcular için ölçüye özel {p.Category.Name.ToLower()} çalışması. Fotoğrafları inceleyin, Çarşı Dekor'dan teklif alın."
        : p.Description;

    // Galeri: kapak görseli + projeye eklenen diğer fotoğraflar
    var images = new List<string>();
    if (!string.IsNullOrEmpty(p.CoverImagePath)) images.Add(p.CoverImagePath);
    images.AddRange(p.Images.OrderBy(i => i.DisplayOrder).Select(i => i.ImagePath));

    var waText = Uri.EscapeDataString($"Merhaba, \"{p.Title}\" projesi hakkında bilgi almak istiyorum.");
}

<section class="section section-tight">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-7">
                @if (images.Any())
                {
                    <div class="gallery-main">
                        <img id="mainImage" src="@images[0]" alt="@p.Title, @p.Category.Name, Çarşı Dekor" fetchpriority="high" />
                    </div>

                    @if (images.Count > 1)
                    {
                        <div class="gallery-thumbs">
                            @for (var i = 0; i < images.Count; i++)
                            {
                                <img class="gallery-thumb @(i == 0 ? "active" : "")" src="@images[i]" data-src="@images[i]"
                                     data-gallery-thumb alt="@p.Title fotoğraf @(i + 1)" decoding="async" loading="lazy" />
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="gallery-main gallery-empty">Bu proje için henüz fotoğraf eklenmedi.</div>
                }
            </div>

            <div class="col-lg-5">
                <h1 class="detail-title">@p.Title</h1>

                @if (!string.IsNullOrWhiteSpace(p.Description))
                {
                    <p class="detail-text">@p.Description</p>
                }

                <dl class="detail-list">
                    <div>
                        <dt>Kategori</dt>
                        <dd>@p.Category.Name</dd>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(p.Materials))
                    {
                        <div>
                            <dt>Malzeme</dt>
                            <dd>@p.Materials</dd>
                        </div>
                    }
                </dl>

                <div class="detail-actions">
                    <a class="btn-ruby" href="https://wa.me/@(SiteInfo.WhatsApp)?text=@waText" target="_blank" rel="noopener">Bu iş için teklif isteyin</a>
                    <a class="btn-ink" asp-page="/Contact">İletişim formu</a>
                </div>
            </div>
        </div>
    </div>
</section>

@if (Model.Related.Any())
{
    <section class="section section-dark">
        <div class="container">
            <div class="section-head">
                <div>
                    <h2>Aynı kategoriden diğer işler</h2>
                </div>
            </div>
            <div class="project-grid">
                @foreach (var r in Model.Related)
                {
                    <partial name="_ProjectCard" model="r" />
                }
            </div>
        </div>
    </section>
}
