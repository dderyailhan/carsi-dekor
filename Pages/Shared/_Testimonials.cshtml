@{
    var items = SiteContent.Testimonials.Where(t => t.Published).ToList();
}
@if (items.Count > 0)
{
    <section class="section section-dark" aria-labelledby="yorum-title">
        <div class="container">
            <div class="section-head">
                <div>
                    <h2 id="yorum-title">Müşterilerimiz ne diyor</h2>
                </div>
            </div>
            <div class="quote-grid">
                @foreach (var t in items)
                {
                    <figure class="quote">
                        <blockquote><p>@t.Text</p></blockquote>
                        <figcaption><strong>@t.Name</strong><span>@t.Business</span></figcaption>
                    </figure>
                }
            </div>
        </div>
    </section>
}
