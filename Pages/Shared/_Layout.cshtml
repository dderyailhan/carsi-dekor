@using System.Text.Json
@inject IConfiguration Config
@{
    var page = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    string Active(string prefix) => page.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) ? "active" : "";

    var waText = Uri.EscapeDataString("Merhaba, vitrin işleriniz hakkında bilgi almak istiyorum.");
    var waLink = $"https://wa.me/{SiteInfo.WhatsApp}?text={waText}";

    // ---- Başlık ve açıklama: her sayfa kendi ViewData["Title"] / ["Description"] değerini verir ----
    var pageTitle = ViewData["Title"] as string;
    var title = !string.IsNullOrWhiteSpace(pageTitle) ? $"{pageTitle} | {SiteInfo.Name}" : SiteInfo.Name;
    var description = ViewData["Description"] as string
        ?? $"{SiteInfo.Name}: kuyumcular için ölçüye özel vitrin, banko, niş, yüzüklük ve manken üretimi. {SiteInfo.District}, {SiteInfo.City}.";

    // ---- Adresler (canonical, paylaşım resmi) ----
    var baseUrl = Seo.BaseUrl(Context.Request, Config);
    var canonicalPath = ViewData["Canonical"] as string ?? Context.Request.Path.Value ?? "/";
    var canonical = Seo.Absolute(baseUrl, canonicalPath == "/Index" ? "/" : canonicalPath);
    var ogImage = Seo.Absolute(baseUrl, ViewData["OgImage"] as string ?? "/images/og-default.jpg");
    var ogType = ViewData["OgType"] as string ?? "website";
    var noIndex = ViewData["NoIndex"] is true;
    var verification = Config["Site:GoogleVerification"];

    // ---- Yol işareti ----
    var crumbs = ViewData["Crumbs"] as List<Crumb>;

    // ---- Google zengin içerik (JSON-LD) ----
    var business = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "LocalBusiness",
        ["@id"] = baseUrl + "/#business",
        ["name"] = SiteInfo.Name,
        ["url"] = baseUrl + "/",
        ["image"] = Seo.Absolute(baseUrl, "/images/og-default.jpg"),
        ["logo"] = Seo.Absolute(baseUrl, "/images/logo.png"),
        ["description"] = "Kuyumcular için ölçüye özel vitrin, banko, niş, yüzüklük ve manken tasarımı ve üretimi.",
        ["telephone"] = SiteInfo.PhoneLink,
        ["email"] = SiteInfo.Email,
        ["address"] = new Dictionary<string, object?>
        {
            ["@type"] = "PostalAddress",
            ["streetAddress"] = SiteInfo.Street,
            ["addressLocality"] = SiteInfo.District,
            ["addressRegion"] = SiteInfo.City,
            ["addressCountry"] = "TR"
        },
        ["hasMap"] = "https://www.google.com/maps?q=" + Uri.EscapeDataString(SiteInfo.MapQuery),
        ["openingHoursSpecification"] = new[]
        {
            new Dictionary<string, object?>
            {
                ["@type"] = "OpeningHoursSpecification",
                ["dayOfWeek"] = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" },
                ["opens"] = "09:00",
                ["closes"] = "19:30"
            }
        }
    };
    if (SiteInfo.SocialLinks.Length > 0) business["sameAs"] = SiteInfo.SocialLinks;
    string breadcrumbJson = "";
    if (crumbs is { Count: > 0 })
    {
        breadcrumbJson = JsonSerializer.Serialize(new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "BreadcrumbList",
            ["itemListElement"] = crumbs.Select((c, i) => new Dictionary<string, object?>
            {
                ["@type"] = "ListItem",
                ["position"] = i + 1,
                ["name"] = c.Name,
                ["item"] = Seo.Absolute(baseUrl, c.Url)
            }).ToArray()
        });
    }
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title</title>
    <meta name="description" content="@description" />
    <meta name="theme-color" content="#17171b" />
    <link rel="canonical" href="@canonical" />
    @if (noIndex)
    {
        <meta name="robots" content="noindex, follow" />
    }
    else
    {
        <meta name="robots" content="index, follow, max-image-preview:large" />
    }
    @if (!string.IsNullOrWhiteSpace(verification))
    {
        <meta name="google-site-verification" content="@verification" />
    }

    <!-- Sosyal medya paylaşım kartları -->
    <meta property="og:site_name" content="@SiteInfo.Name" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:type" content="@ogType" />
    <meta property="og:title" content="@title" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:image" content="@ogImage" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@title" />
    <meta name="twitter:description" content="@description" />
    <meta name="twitter:image" content="@ogImage" />

    <link rel="icon" href="~/favicon.ico" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600&family=Marcellus&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <script type="application/ld+json">@Html.Raw(JsonSerializer.Serialize(business))</script>
    @if (!string.IsNullOrEmpty(breadcrumbJson))
    {
        <script type="application/ld+json">@Html.Raw(breadcrumbJson)</script>
    }
    @await RenderSectionAsync("Head", required: false)
</head>
<body>

<a class="skip-link" href="#icerik">İçeriğe geç</a>

<div class="topbar">
    <div class="container">
        <span class="topbar-text">Vitrininiz için ücretsiz görüşme ve teklif</span>
        <div class="topbar-actions">
            <a href="tel:@SiteInfo.PhoneLink" class="topbar-phone">@SiteInfo.Phone</a>
            <a href="@waLink" target="_blank" rel="noopener" class="topbar-wa">WhatsApp'tan yazın</a>
            <a asp-page="/Contact" class="topbar-quote">Teklif alın</a>
        </div>
    </div>
</div>

<header class="site-header">
    <a class="brand" asp-page="/Index" aria-label="@SiteInfo.Name ana sayfa">
        <img src="~/images/logo.png" alt="@SiteInfo.Name" class="brand-logo" width="285" height="84" />
    </a>

    <nav class="navbar navbar-expand-md navbar-dark site-nav" aria-label="Ana menü">
        <div class="container">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Menüyü aç">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-center" id="mainNav">
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link @Active("/Index")" asp-page="/Index">Ana sayfa</a></li>
                    <li class="nav-item"><a class="nav-link @Active("/Projects")" asp-page="/Projects/Index">Kategoriler</a></li>
                    @if (SiteContent.CaseStudies.Any(c => c.Published))
                    {
                        <li class="nav-item"><a class="nav-link @Active("/CaseStudies")" asp-page="/CaseStudies">Vaka çalışmaları</a></li>
                    }
                    <li class="nav-item"><a class="nav-link @Active("/About")" asp-page="/About">Hakkımızda</a></li>
                    <li class="nav-item"><a class="nav-link @Active("/Contact")" asp-page="/Contact">İletişim</a></li>
                </ul>
            </div>
        </div>
    </nav>
</header>

@if (crumbs is { Count: > 1 })
{
    <nav class="crumb-bar" aria-label="Sayfa yolu">
        <div class="container">
            <ol>
                @for (var i = 0; i < crumbs.Count; i++)
                {
                    if (i < crumbs.Count - 1)
                    {
                        <li><a href="@crumbs[i].Url">@crumbs[i].Name</a></li>
                    }
                    else
                    {
                        <li aria-current="page">@crumbs[i].Name</li>
                    }
                }
            </ol>
        </div>
    </nav>
}

<main id="icerik">
    @RenderBody()
</main>

<footer class="site-footer">
    <div class="container">
        <div class="row g-5">
            <div class="col-md-4">
                <img src="~/images/logo.png" alt="@SiteInfo.Name" class="footer-logo" width="285" height="84" loading="lazy" />
                <p class="mt-3">Kuyumcular için ölçüye özel vitrin tasarımı ve marangozluk işçiliği.</p>
            </div>
            <div class="col-6 col-md-2">
                <h3 class="footer-title">Sayfalar</h3>
                <ul class="footer-list">
                    <li><a asp-page="/Index">Ana sayfa</a></li>
                    <li><a asp-page="/Projects/Index">Kategoriler</a></li>
                    @if (SiteContent.CaseStudies.Any(c => c.Published))
                    {
                        <li><a asp-page="/CaseStudies">Vaka çalışmaları</a></li>
                    }
                    <li><a asp-page="/About">Hakkımızda</a></li>
                    <li><a asp-page="/Contact">İletişim</a></li>
                    <li><a asp-page="/Privacy">Gizlilik politikası</a></li>
                </ul>
            </div>
            <div class="col-6 col-md-2">
                <h3 class="footer-title">Ürünler</h3>
                <ul class="footer-list">
                    <li><a asp-page="/Projects/Index" asp-route-kategori="vitrinler">Vitrinler</a></li>
                    <li><a asp-page="/Projects/Index" asp-route-kategori="bankolar">Bankolar</a></li>
                    <li><a asp-page="/Projects/Index" asp-route-kategori="nisler">Nişler</a></li>
                    <li><a asp-page="/Projects/Index" asp-route-kategori="mankenler">Mankenler</a></li>
                    <li><a asp-page="/Projects/Index" asp-route-kategori="yuzukluk">Yüzüklük</a></li>
                </ul>
            </div>
            <div class="col-md-4">
                <h3 class="footer-title">İletişim</h3>
                <ul class="footer-list">
                    <li><a href="tel:@SiteInfo.PhoneLink">@SiteInfo.Phone</a></li>
                    <li><a href="mailto:@SiteInfo.Email">@SiteInfo.Email</a></li>
                    <li>
                        <address>@SiteInfo.Address</address>
                        <a class="footer-map-link" target="_blank" rel="noopener"
                           href="https://www.google.com/maps/search/?api=1&amp;query=@Uri.EscapeDataString(SiteInfo.MapQuery)">Yol tarifi al</a>
                    </li>
                    <li>@SiteInfo.WorkingHours</li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            © @DateTime.Now.Year @SiteInfo.Name. Tüm hakları saklıdır.
        </div>
    </div>
</footer>

<!-- Masaüstü: sağ altta WhatsApp -->
<a class="wa-float" href="@waLink" target="_blank" rel="noopener" aria-label="WhatsApp ile yazın">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2z"/></svg>
    <span>WhatsApp</span>
</a>

<!-- Telefon: ekranın altına yapışık Ara / WhatsApp çubuğu -->
<div class="sticky-cta" role="complementary" aria-label="Hızlı iletişim">
    <a class="sticky-cta-call" href="tel:@SiteInfo.PhoneLink">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>
        Hemen arayın
    </a>
    <a class="sticky-cta-wa" href="@waLink" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2z"/></svg>
        WhatsApp
    </a>
</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" defer></script>
<script src="~/js/site.js" defer></script>
<script src="~/js/lightbox.js" defer></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
